#include <stdio.h>
#include <stdlib.h>

char** read_file(char* name, int* lc) {
	FILE* input = fopen(name,"r");
	fseek(input, 0L, SEEK_END);
	long length = ftell(input) + 1;
	fseek(input, 0L, SEEK_SET);
	char* buffer  = malloc(length);
	int n = fread(buffer, sizeof(char), length, input);
	fclose(input);
	buffer[n] = '\0';
	int line_count = 1;
	for (long i = 0; i < n; i++) {
		if (buffer[i]== '\n') {
			line_count++;
		}
	}
	*lc = line_count;
	char** lines = malloc(line_count * sizeof (*lines));
	int j = 0;
	lines[j] = buffer;
	j++;
	for (int i = 0; i<n; i++) {
		if (buffer[i] == '\n') {
			buffer[i] = 0;
			if (i+ 1 < n) lines [j++] = & buffer[i + 1];
		}
	}
	return lines;
}

int fuel(int mass) {
	printf("calculate fuel for mass %i\n", mass);
	int f = mass / 3 - 2;
	if (f > 0)
	    return (f + fuel(f));
	else
		return 0;
}

int main() {
	int i = 0;
	int size;
	int ans = 0;
	int total = 0;

	char** puzzle = read_file("day1-2019-input.txt", &size);
	printf("%i\n", size);
	while( i < size) {
		ans = fuel(atoi (puzzle[i]));
		printf("%s %i \n", puzzle[i], ans);
		total += ans;
		i++;
	}
	printf("total = %i\n", total);
	return 0;
}
